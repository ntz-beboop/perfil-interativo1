<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Perfil | ntz</title>

  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="background"></div>

  <main class="card">

    <!-- FOTO DO SPIKE -->
    <div class="avatar">
      <img 
        src="https://avatars.githubusercontent.com/u/9919?s=280&v=4"
        alt="Spike Spiegel"
      >
    </div>

    <h1>Ericson Zirhut Neto</h1>
    <h2>@ntz</h2>

    <p class="bio">
      Apaixonado por tecnologia, design e experiências interativas.
      Sempre buscando evoluir e criar coisas novas.
    </p>

    <section class="hobbies">
      <h3>🎯 Hobbies</h3>

      <div class="hobby-list">
        <div class="hobby">🎮 Jogar</div>
        <div class="hobby">📚 Estudar</div>
        <div class="hobby">🍕 Sair com os amigos</div>
      </div>
    </section>

    <div class="buttons">
      <button id="themeBtn">Trocar Tema</button>
      <button id="msgBtn">Mensagem</button>
    </div>

    <div class="socials">
      <a href="#">Instagram</a>
      <a href="#">GitHub</a>
      <a href="#">Discord</a>
    </div>

  </main>

  <div id="toast" class="toast">
    👋 Salve, ntz!
  </div>

  <script src="script.js"></script>

</body>
</html>
